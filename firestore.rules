rules_version = '2';
/* MOI — Firestore Rules (ধাপ ১: উন্নয়নের সময়ের সহজ নিয়ম)
   এখন: লগইন করা (গেস্ট সহ) যে কেউ সব পড়তে ও লিখতে পারে — কোনো Cloud Function লাগে না।
   🔒 LOCK-LATER: অ্যাপ সম্পূর্ণ হলে ডায়মন্ড, রোল, লেভেল, মুকুট, লেনদেনের জায়গায় কড়া নিয়ম বসানো হবে। */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
